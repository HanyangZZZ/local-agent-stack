{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Agent Stack",
  "version": "0.1.1-alpha.2",
  "identifier": "dev.localagentstack.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Agent Stack",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; frame-src http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4QkE4OUIyNkQzQ0VGRjAKUldUdzd6eHRzb202K0tLeFdjU2w3WUc1VHJ5aFFzMWhXU0N3NUFJcFhFc2JpMitSWWFiWU5XamsK",
      "endpoints": [
        "https://raw.githubusercontent.com/HanyangZZZ/local-agent-stack/main/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
