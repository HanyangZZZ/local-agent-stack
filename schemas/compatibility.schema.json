{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localagentstack.dev/schemas/compatibility.schema.json",
  "title": "Local Agent Stack compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "components", "artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "kind": { "enum": ["ollama", "harness"] },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "displayName",
        "minimumVersion",
        "maximumVersionExclusive",
        "recommendedVersion",
        "source"
      ],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "displayName": { "type": "string", "minLength": 1 },
        "minimumVersion": { "$ref": "#/$defs/version" },
        "maximumVersionExclusive": { "$ref": "#/$defs/version" },
        "recommendedVersion": { "$ref": "#/$defs/version" },
        "source": { "type": "string", "format": "uri" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "operatingSystem",
        "architecture",
        "url",
        "sha256",
        "downloadSize",
        "maximumExtractedSize",
        "archiveFormat",
        "executableRelativePath"
      ],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "version": { "$ref": "#/$defs/version" },
        "operatingSystem": { "enum": ["windows", "macos", "linux"] },
        "architecture": { "enum": ["x86_64", "aarch64"] },
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "downloadSize": { "type": "integer", "minimum": 1 },
        "maximumExtractedSize": { "type": "integer", "minimum": 1 },
        "archiveFormat": { "enum": ["zip", "tar.gz"] },
        "executableRelativePath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
