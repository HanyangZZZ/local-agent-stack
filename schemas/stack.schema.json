{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localagentstack.dev/schemas/stack.schema.json",
  "title": "Local Agent Stack configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["ollama", "harness", "harnessProfile"],
  "properties": {
    "ollama": { "$ref": "#/$defs/service" },
    "harness": { "$ref": "#/$defs/service" },
    "harnessHome": { "type": ["string", "null"] },
    "harnessProfile": { "type": "string", "minLength": 1 },
    "managedHarnessNode": { "type": ["string", "null"] },
    "managedHarnessSource": { "type": ["string", "null"] },
    "managedHarnessEntrypoint": { "type": ["string", "null"] },
    "setupCompleted": { "type": "boolean", "default": false },
    "trace": { "$ref": "#/$defs/trace" }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "args"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "command": { "type": ["string", "null"] },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "sessionRoot": { "type": ["string", "null"] },
        "gpuSampleIntervalMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 60000,
          "default": 1000
        },
        "inferenceSlots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 4
        }
      }
    }
  }
}
